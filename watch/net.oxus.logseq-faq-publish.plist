<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.oxus.logseq-faq-publish</string>

	<key>ProgramArguments</key>
	<!-- The first entry is a compiled launcher (watch/install.sh builds it):
	     macOS will not run a script directly here, and names the job in
	     Login Items after this file. It runs the bash line below unchanged. -->
	<array>
		<string>/Users/niyaro/Code/logseq-faq/watch/bin/logseq-faq-publish</string>
		<string>/bin/bash</string>
		<string>/Users/niyaro/Code/logseq-faq/watch/logseq-faq-publish.sh</string>
	</array>

	<key>WatchPaths</key>
	<array>
		<string>/Users/niyaro/Code/logseq-faq/export</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/niyaro/Library/Logs/logseq-faq-publish.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/niyaro/Library/Logs/logseq-faq-publish.log</string>

	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
